      { "name": "Centre", "where": "Old Market Square, NG1 2BS", "lat": 52.953486, "lng": -1.149067, "arrive": "Sat 12:00", "window": 60, "max": 25 },
      { "name": "City Ground", "where": "NG2 5FJ, for a 15:00 kick-off", "lat": 52.939464, "lng": -1.133196, "arrive": "Sat 14:45", "window": 60 },
      { "name": "Motorpoint Arena", "where": "NG1 1LA, for an evening game", "lat": 52.952483, "lng": -1.139649, "arrive": "Sat 18:45", "window": 60 }
    ]
