# The variables the app reads. With Coolify, set them in the app's Environment Variables tab, not in a file.
# Locally none of them are needed: claude uses your own login and the server binds to localhost without auth.

# Long-lived subscription token for headless claude, made on your Mac with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# The password for the dashboard at /admin (and the Ideas, Jobs and Newsletters pages). Empty = no /admin.
ADMIN_PASSWORD=

# Timezone for the clock prompts and scripts see; schedules use the timezone in each task.json.
TZ=Europe/London

# Optional. TypeSafe key (console.typesafe.ai/keys): Jev's for-you scores, the news filter and the ideas radar.
TYPESAFE_API_KEY=
# Optional. An Aletheia capture key: "Save to notes" on every story for a logged-in reader.
ALETHEIA_CAPTURE_KEY=
# Optional. A hard-to-guess ntfy topic: tasks with "notify" push their biggest stories to your phone.
NTFY_TOPIC=
# Optional. The site's https address, so a notification opens the paper.
PUBLIC_URL=
# Optional. Free keys from developer.adzuna.com and reed.co.uk/developers for the job tracker.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
